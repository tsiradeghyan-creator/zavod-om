{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/glyph_gate_report",
  "title": "Glyph Gate Report",
  "description": "Output of lib/armenian_glyph_gate.py — per-text-element script-purity check.",
  "type": "object",
  "required": ["version", "verdict", "violations"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "checked": { "type": "integer", "minimum": 0 },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "reason"],
        "properties": {
          "text": { "type": "string" },
          "field": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
