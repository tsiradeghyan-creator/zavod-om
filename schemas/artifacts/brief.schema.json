{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/brief",
  "title": "Creative Brief",
  "description": "Creative brief produced by the Idea Explorer agent. Supports timed media and format-neutral written content.",
  "type": "object",
  "required": ["version", "title", "hook", "key_points", "tone", "style", "target_platform"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "hook": { "type": "string", "description": "Opening hook / attention grabber" },
    "key_points": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "core_message": { "type": "string" },
    "cta": { "type": "string", "description": "Call to action" },
    "tone": { "type": "string" },
    "style": { "type": "string", "description": "Style playbook name or custom description" },
    "content_format": {
      "type": "string",
      "enum": ["social_post", "caption", "article", "newsletter", "screenplay", "series_episode", "stageplay", "video", "carousel", "promo"]
    },
    "target_audience": { "type": "string" },
    "target_platform": {
      "type": "string",
      "enum": ["youtube", "instagram", "tiktok", "linkedin", "facebook", "telegram", "website", "email", "podcast", "print", "generic"]
    },
    "target_duration_seconds": { "type": "number", "minimum": 1 },
    "target_length": {
      "type": "object",
      "required": ["unit", "value"],
      "properties": {
        "unit": { "type": "string", "enum": ["words", "characters", "pages", "scenes", "episodes", "slides"] },
        "value": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "reference_material": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths or URLs to source material"
    },
    "angle_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["name", "description"]
      },
      "description": "2-3 angle options for user to choose from"
    },
    "selected_angle": { "type": "string" },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Production risk categories this brief matches (e.g. paid_client_delivery, new_series_launch, legal_or_sensitive_topic). A fast-lane manifest's metadata.fast_lane.owner_override_required_if names the subset that requires owner_override to close idea (round-7.1 #5)."
    },
    "owner_override": {
      "type": "object",
      "description": "Structured owner sign-off required when risk_flags intersects the pipeline's owner_override_required_if list.",
      "required": ["approved_by", "reason", "covers"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Which risk_flags this override addresses."
        }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_format": {
            "enum": ["social_post", "caption", "article", "newsletter", "screenplay", "series_episode", "stageplay"]
          }
        },
        "required": ["content_format"]
      },
      "then": { "required": ["target_length"] },
      "else": { "required": ["target_duration_seconds"] }
    }
  ],
  "additionalProperties": false
}
